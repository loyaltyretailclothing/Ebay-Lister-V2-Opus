# Which keys the app needs. Names only — fill the values in yourself, here
# for local work and in Vercel for the live site. Never commit real values.

ANTHROPIC_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_OAUTH_REFRESH_TOKEN=
EBAY_RUNAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EBAY_SANDBOX=false
GOOGLE_CLOUD_API_KEY=

# Seasonal Hold. CRON_SECRET is what stops anyone else starting a posting
# morning — set it in Vercel, or the 7am job is open to the world.
CRON_SECRET=
# The site's own address, used by the posting run to call itself. Vercel
# fills this in by itself; only set it if that ever needs overriding.
NEXT_PUBLIC_SITE_URL=

# Optional. Without it the AI simply skips looking up a style number.
BRAVE_SEARCH_API_KEY=
