# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template of which keys are needed belongs in the repo. It holds
# names only, never values.
!.env.local.example

# Claude Code's per-machine permissions — never committed (see CLAUDE.md).
.claude/settings.local.json

# vercel
.vercel

# obsidian (per-user app settings for the docs vault)
docs/.obsidian/

# typescript
*.tsbuildinfo
next-env.d.ts
